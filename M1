    {
      "cell_type": "code",
      "source": [
        "cols_numericas = [\n",
        "    'Air temperature [K]',\n",
        "    'Process temperature [K]',\n",
        "    'Rotational speed [rpm]',\n",
        "    'Torque [Nm]',\n",
        "    'Tool wear [min]'\n",
        "]\n",
        "\n",
        "Q1 = df[cols_numericas].quantile(0.25)\n",
        "Q3 = df[cols_numericas].quantile(0.75)\n",
        "IQR = Q3 - Q1\n",
        "\n",
        "lower = Q1 - 1.5 * IQR\n",
        "upper = Q3 + 1.5 * IQR\n",
        "\n",
        "df[cols_numericas] = df[cols_numericas].clip(lower, upper, axis=1)"
